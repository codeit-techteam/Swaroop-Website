# =============================================================================
# PolyStoreX Website — environment TEMPLATE (safe to commit)
# Every NEXT_PUBLIC_* value is shipped to the browser. Never put secrets here.
# Copy to `.env.local` for local work. Real secrets belong in Vercel env vars.
# =============================================================================

NEXT_PUBLIC_SITE_URL=https://polystorex.com
NEXT_PUBLIC_SITEMAP_HOST=https://www.polystorex.com

# Public API base (no auth tokens)
NEXT_PUBLIC_API_BASE_URL=https://your-api-host.example.com/api/v1
NEXT_PUBLIC_API_TIMEOUT=30000

NEXT_PUBLIC_CUSTOMER_APP_URL=https://customer.polystorex.com
NEXT_PUBLIC_SELLER_APP_URL=https://seller.polystorex.com
NEXT_PUBLIC_ADMIN_APP_URL=https://admin.polystorex.com

# NEXT_PUBLIC_PLAY_STORE_URL=
# NEXT_PUBLIC_APP_STORE_URL=

NEXT_PUBLIC_ENABLE_ANALYTICS=false

NEXT_PUBLIC_CONTACT_EMAIL=connect@polystorex.com
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_YOUTUBE=

# Sanity CMS — public project id/dataset only; never commit write tokens
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
NEXT_PUBLIC_BLOG_PUBLISHED=false

# Local proxy tip (do not deploy with localhost SITE_URL):
#   API_PROXY_TARGET=https://your-api-host.example.com
#   NEXT_PUBLIC_API_BASE_URL=/api/v1
#   NEXT_PUBLIC_SITE_URL=http://localhost:3004
