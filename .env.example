# =============================================================================
# PolyStoreX Website - environment template
# Every NEXT_PUBLIC_* value is shipped to the browser. Never put secrets here.
# =============================================================================

# Canonical public URL of this website (SEO, Open Graph). Prefer apex OR www —
# keep consistent with Vercel primary domain. Do NOT set localhost in production.
NEXT_PUBLIC_SITE_URL=https://polystorex.com

# Sitemap host for robots.txt (client requirement: WWW HTTPS).
NEXT_PUBLIC_SITEMAP_HOST=https://www.polystorex.com

# PolyStoreX centralized backend (DigitalOcean App Platform).
NEXT_PUBLIC_API_BASE_URL=https://swaroop-backend-xzwkz.ondigitalocean.app/api/v1
NEXT_PUBLIC_API_TIMEOUT=30000

# Authenticated product platforms (defaults in lib/env.ts).
NEXT_PUBLIC_CUSTOMER_APP_URL=https://customer.polystorex.com
NEXT_PUBLIC_SELLER_APP_URL=https://seller.polystorex.com
NEXT_PUBLIC_ADMIN_APP_URL=https://admin.polystorex.com

# Store listings — leave unset until Play Store / App Store URLs are published.
# NEXT_PUBLIC_PLAY_STORE_URL=
# NEXT_PUBLIC_APP_STORE_URL=

# Pushes CTA / funnel events to window.dataLayer (no third-party script is loaded).
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Optional overrides (company defaults live in content/company.ts).
NEXT_PUBLIC_CONTACT_EMAIL=it@polystorex.com
NEXT_PUBLIC_CONTACT_PHONE=+919962620101
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_YOUTUBE=

# -----------------------------------------------------------------------------
# Local development against the deployed backend (it rejects CORS from
# localhost). Requests go same-origin and Next proxies them:
#   API_PROXY_TARGET=https://swaroop-backend-xzwkz.ondigitalocean.app
#   NEXT_PUBLIC_API_BASE_URL=/api/v1
#   NEXT_PUBLIC_SITE_URL=http://localhost:3004
# Never deploy with localhost SITE_URL — robots.txt and sitemap will break.
# -----------------------------------------------------------------------------
