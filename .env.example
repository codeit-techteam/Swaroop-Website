# =============================================================================
# SWAROOP Website — environment template
# Every NEXT_PUBLIC_* value is shipped to the browser. Never put secrets here.
# Unset values fall back to the deployed Swaroop production endpoints.
# =============================================================================

# Canonical public URL of this website (used for SEO, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://swaroop-website.vercel.app

# Swaroop centralized backend (DigitalOcean App Platform).
NEXT_PUBLIC_API_BASE_URL=https://swaroop-backend-xzwkz.ondigitalocean.app/api/v1
NEXT_PUBLIC_API_TIMEOUT=30000

# Authenticated product platforms the website hands off to.
NEXT_PUBLIC_CUSTOMER_APP_URL=https://swaroop-customer-webapp.vercel.app
NEXT_PUBLIC_SELLER_APP_URL=https://swaroop-seller-webapp.vercel.app

# Pushes CTA / funnel events to window.dataLayer (no third-party script is loaded).
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Publish ONLY verified business contact details / social profiles.
# Leave blank to hide them on the website.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_YOUTUBE=

# -----------------------------------------------------------------------------
# Local development against the deployed backend (it rejects CORS from
# localhost). Requests go same-origin and Next proxies them:
#   API_PROXY_TARGET=https://swaroop-backend-xzwkz.ondigitalocean.app
#   NEXT_PUBLIC_API_BASE_URL=/api/v1
#   NEXT_PUBLIC_SITE_URL=http://localhost:3004
# -----------------------------------------------------------------------------
